datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id       Int     @id @default(autoincrement())
  name     String
  province String
  entries  Entry[]
}

model Entry {
  id            Int         @id @default(autoincrement())
  category      String?
  value         Float?
  planArea      Float       @default(0)
  planDone      Float       @default(0)
  actualArea    Float       @default(0)
  interventionArea Float    @default(0)
  householdPlan Float       @default(0)
  householdDone Float       @default(0)
  unsalvageableArea Float   @default(0)
  overUnderPlan Float       @default(0)
  waterSource   String      @default("")
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  department    Department? @relation(fields: [departmentId], references: [id])
  departmentId  Int?
  userId        Int?
  provinceId    Int?
  districtId    Int?
  user          User?       @relation(fields: [userId], references: [id])
  province      Province?   @relation(fields: [provinceId], references: [id])
  district      District?   @relation(fields: [districtId], references: [id])
  auditLogs     AuditLog[]
}

model User {
  id               Int        @id @default(autoincrement())
  username         String     @unique
  passwordHash     String
  role             String     @default("user")
  isActive         Boolean    @default(true)
  provinceId       Int?
  province         Province?  @relation(fields: [provinceId], references: [id])
  entries          Entry[]
  waterEntries     ProvinceWaterEntry[]
  createdDistricts District[] @relation("DistrictCreator")
  createdCommunes  Commune[]  @relation("CommuneCreator")
  auditLogs        AuditLog[] @relation("AuditActor")

  @@index([isActive])
}

model Province {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  khmerName   String     @default("")
  code        String?    @unique
  postalCode  Int?
  sortOrder   Int?
  users       User[]
  districts   District[]
  entries     Entry[]
  waterEntries ProvinceWaterEntry[]
  communes     Commune[]
  auditLogs   AuditLog[]

  @@index([sortOrder])
}

model District {
  id              Int      @id @default(autoincrement())
  name            String
  khmerName       String   @default("")
  geocode         String?
  provinceId      Int
  createdByUserId Int?
  createdAt       DateTime @default(now())
  province        Province @relation(fields: [provinceId], references: [id])
  createdByUser   User?    @relation("DistrictCreator", fields: [createdByUserId], references: [id])
  entries         Entry[]
  waterEntries    ProvinceWaterEntry[]
  communes        Commune[]

  @@unique([provinceId, name])
}

model ProvinceWaterEntry {
  id           Int       @id @default(autoincrement())
  basinName    String
  location     String
  districtName String
  communeName  String?
  totalWater   Float     @default(0)
  waterPercent  Float     @default(0)
  actualWater  Float     @default(0)
  irrigatedDryArea Float  @default(0)
  irrigatedWetArea Float  @default(0)
  waterSource  String    @default("")
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  provinceId   Int
  districtId   Int?
  communeId    Int?
  userId       Int?
  province     Province  @relation(fields: [provinceId], references: [id])
  district     District? @relation(fields: [districtId], references: [id])
  commune      Commune?  @relation(fields: [communeId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])

  @@index([provinceId, createdAt])
  @@index([districtId])
  @@index([communeId])
}

model Commune {
  id              Int      @id @default(autoincrement())
  name            String
  khmerName       String   @default("")
  geocode         String?
  numVillages     Int?
  districtId      Int?
  provinceId      Int
  createdByUserId Int?
  createdAt       DateTime @default(now())
  province        Province  @relation(fields: [provinceId], references: [id])
  district        District? @relation(fields: [districtId], references: [id])
  createdByUser   User?     @relation("CommuneCreator", fields: [createdByUserId], references: [id])
  waterEntries    ProvinceWaterEntry[]

  @@unique([provinceId, name])
  @@index([districtId])
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  action        String
  entityType    String
  entityId      Int?
  actorUserId   Int?
  actorUsername String
  provinceId    Int?
  entryId       Int?
  changes       Json
  createdAt     DateTime  @default(now())
  actorUser     User?     @relation("AuditActor", fields: [actorUserId], references: [id])
  province      Province? @relation(fields: [provinceId], references: [id])
  entry         Entry?    @relation(fields: [entryId], references: [id])
}
