datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id       Int     @id @default(autoincrement())
  name     String
  province String
  entries  Entry[]
}

model Entry {
  id                       Int         @id @default(autoincrement())
  category                 String?
  value                    Float?
  planArea                 Float       @default(0)
  planDone                 Float       @default(0)
  actualArea               Float       @default(0)
  interventionArea         Float       @default(0)
  interventionAreaDrought  Float       @default(0)
  interventionAreaFlood    Float       @default(0)
  householdPlan            Float       @default(0)
  householdDone            Float       @default(0)
  householdDoneDrought     Float       @default(0)
  householdDoneFlood       Float       @default(0)
  unsalvageableArea        Float       @default(0)
  unsalvageableAreaDrought Float       @default(0)
  unsalvageableAreaFlood   Float       @default(0)
  overUnderPlan            Float       @default(0)
  waterSource              String      @default("")
  note                     String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  department               Department? @relation(fields: [departmentId], references: [id])
  departmentId             Int?
  userId                   Int?
  provinceId               Int?
  districtId               Int?
  user                     User?       @relation(fields: [userId], references: [id])
  province                 Province?   @relation(fields: [provinceId], references: [id])
  district                 District?   @relation(fields: [districtId], references: [id])
  auditLogs                AuditLog[]
}

model User {
  id                            Int                     @id @default(autoincrement())
  username                      String                  @unique
  passwordHash                  String
  role                          String                  @default("user")
  isActive                      Boolean                 @default(true)
  provinceId                    Int?
  province                      Province?               @relation(fields: [provinceId], references: [id])
  entries                       Entry[]
  waterEntries                  ProvinceWaterEntry[]
  createdDistricts              District[]              @relation("DistrictCreator")
  createdCommunes               Commune[]               @relation("CommuneCreator")
  createdStations               Station[]               @relation("StationCreator")
  createdMeteorologicalStations MeteorologicalStation[] @relation("MeteorologicalStationCreator")
  stationReports                StationReport[]
  auditLogs                     AuditLog[]              @relation("AuditActor")
  temperatures                  DailyTemperature[]
  rainfalls                     DailyRainfall[]
  forecasts                     DailyForecast[]
  fwucs                         Fwuc[]
  floodReports                  ProvincialFloodReport[]

  @@index([isActive])
}

model Province {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique
  khmerName              String                  @default("")
  code                   String?                 @unique
  postalCode             Int?
  sortOrder              Int?
  users                  User[]
  districts              District[]
  entries                Entry[]
  waterEntries           ProvinceWaterEntry[]
  communes               Commune[]
  stations               Station[]
  meteorologicalStations MeteorologicalStation[]
  auditLogs              AuditLog[]
  temperatures           DailyTemperature[]
  rainfalls              DailyRainfall[]
  forecasts              DailyForecast[]
  fwucs                  Fwuc[]
  floodReports           ProvincialFloodReport[]

  @@index([sortOrder])
}

model District {
  id                     Int                     @id @default(autoincrement())
  name                   String
  khmerName              String                  @default("")
  geocode                String?
  provinceId             Int
  createdByUserId        Int?
  createdAt              DateTime                @default(now())
  province               Province                @relation(fields: [provinceId], references: [id])
  createdByUser          User?                   @relation("DistrictCreator", fields: [createdByUserId], references: [id])
  entries                Entry[]
  waterEntries           ProvinceWaterEntry[]
  communes               Commune[]
  stations               Station[]
  meteorologicalStations MeteorologicalStation[]
  rainfalls              DailyRainfall[]
  fwucs                  Fwuc[]
  floodReports           ProvincialFloodReport[]

  @@unique([provinceId, name])
}

model ProvinceWaterEntry {
  id               Int       @id @default(autoincrement())
  basinName        String
  location         String
  districtName     String
  communeName      String?
  totalWater       Float     @default(0)
  waterPercent     Float     @default(0)
  actualWater      Float     @default(0)
  irrigatedDryArea Float     @default(0)
  irrigatedWetArea Float     @default(0)
  otherCrop        Float     @default(0)
  waterSource      String    @default("")
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  provinceId       Int
  districtId       Int?
  communeId        Int?
  userId           Int?
  province         Province  @relation(fields: [provinceId], references: [id])
  district         District? @relation(fields: [districtId], references: [id])
  commune          Commune?  @relation(fields: [communeId], references: [id])
  user             User?     @relation(fields: [userId], references: [id])

  @@index([provinceId, createdAt])
  @@index([districtId])
  @@index([communeId])
}

model Commune {
  id                     Int                     @id @default(autoincrement())
  name                   String
  khmerName              String                  @default("")
  geocode                String?
  numVillages            Int?
  districtId             Int?
  provinceId             Int
  createdByUserId        Int?
  createdAt              DateTime                @default(now())
  province               Province                @relation(fields: [provinceId], references: [id])
  district               District?               @relation(fields: [districtId], references: [id])
  createdByUser          User?                   @relation("CommuneCreator", fields: [createdByUserId], references: [id])
  waterEntries           ProvinceWaterEntry[]
  stations               Station[]
  fwucs                  Fwuc[]
  meteorologicalStations MeteorologicalStation[]

  @@unique([provinceId, name])
  @@index([districtId])
}

model Station {
  id                  Int       @id @default(autoincrement())
  name                String
  khmerName           String    @default("")
  river               String?
  category            String?
  monitoringFunctions String?
  warningLevel        Float?
  maxCapacityLevel    Float?
  status              String?
  installationDate    DateTime?
  remark              String?
  latitude            Float?
  longitude           Float?
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provinceId          Int
  districtId          Int?
  communeId           Int?
  createdByUserId     Int?

  province      Province        @relation(fields: [provinceId], references: [id])
  district      District?       @relation(fields: [districtId], references: [id])
  commune       Commune?        @relation(fields: [communeId], references: [id])
  createdByUser User?           @relation("StationCreator", fields: [createdByUserId], references: [id])
  reports       StationReport[]

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model StationReport {
  id                  Int      @id @default(autoincrement())
  stationId           Int
  reportDate          DateTime
  waterLevel          Float
  waterLevelYesterday Float?
  waterLevelLastYear  Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  userId              Int?

  station Station @relation(fields: [stationId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([stationId, reportDate])
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  action        String
  entityType    String
  entityId      Int?
  actorUserId   Int?
  actorUsername String
  provinceId    Int?
  entryId       Int?
  changes       Json
  createdAt     DateTime  @default(now())
  actorUser     User?     @relation("AuditActor", fields: [actorUserId], references: [id])
  province      Province? @relation(fields: [provinceId], references: [id])
  entry         Entry?    @relation(fields: [entryId], references: [id])
}

model DailyTemperature {
  id         Int      @id @default(autoincrement())
  reportDate DateTime
  maxTemp    Float
  minTemp    Float
  provinceId Int
  userId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province Province @relation(fields: [provinceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([provinceId, reportDate])
  @@index([provinceId, reportDate])
}

model DailyRainfall {
  id          Int      @id @default(autoincrement())
  reportDate  DateTime
  stationName String
  rainfall    Float    @default(0)
  provinceId  Int
  districtId  Int?
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([provinceId, reportDate])
  @@index([districtId])
}

model DailyForecast {
  id           Int      @id @default(autoincrement())
  reportDate   DateTime
  forecastText String
  provinceId   Int
  userId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  province Province @relation(fields: [provinceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([provinceId, reportDate])
  @@index([provinceId, reportDate])
}

model Fwuc {
  id                 Int       @id @default(autoincrement())
  name               String
  provinceId         Int
  districtId         Int?
  communeId          Int?
  longitude          Float?
  latitude           Float?
  registrationPlace  String?
  registrationNumber String?
  registrationDate   DateTime?
  irrigatedDryArea   Float     @default(0)
  irrigatedWetArea   Float     @default(0)
  efficiency         String?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             Int?

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  commune  Commune?  @relation(fields: [communeId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model MeteorologicalStation {
  id                  Int       @id @default(autoincrement())
  name                String
  khmerName           String    @default("")
  river               String?
  category            String?
  monitoringFunctions String?
  powerSupply         String?
  communication       String?
  elevation           Float?
  warningLevel        Float?
  maxCapacityLevel    Float?
  status              String?
  installationDate    DateTime?
  remark              String?
  latitude            Float?
  longitude           Float?
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provinceId          Int
  districtId          Int?
  communeId           Int?
  createdByUserId     Int?

  province      Province  @relation(fields: [provinceId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])
  commune       Commune?  @relation(fields: [communeId], references: [id])
  createdByUser User?     @relation("MeteorologicalStationCreator", fields: [createdByUserId], references: [id])

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model WaterInfrastructure {
  id                      Int                   @id @default(autoincrement())
  provincialFloodReportId Int
  type                    String?               
  name                    String?               
  locationX               String?               
  locationY               String?               
  damagedLength           Float                 @default(0) 
  status                  String?               
  note                    String?               
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  provincialFloodReport   ProvincialFloodReport @relation(fields: [provincialFloodReportId], references: [id], onDelete: Cascade)
  
  @@index([provincialFloodReportId])
}

model ProvincialFloodReport {
  id                          Int      @id @default(autoincrement())
  reportDate                  DateTime @default(now())
  provinceId                  Int
  districtId                  Int?
  communesCount               Int      @default(0) 
  affectedFamilies            Int      @default(0) 
  affectedRiceCrops           Float    @default(0) 
  damagedRiceCrops            Float    @default(0) 
  note                        String?              
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  userId                      Int?

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  waterInfrastructures        WaterInfrastructure[]

  @@index([provinceId])
  @@index([districtId])
}
