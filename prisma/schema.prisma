datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id       Int     @id @default(autoincrement())
  name     String
  province String
  entries  Entry[]
}

model Entry {
  id                       Int         @id @default(autoincrement())
  category                 String?
  value                    Float?
  planArea                 Float       @default(0)
  planDone                 Float       @default(0)
  actualArea               Float       @default(0)
  interventionArea         Float       @default(0)
  interventionAreaDrought  Float       @default(0)
  interventionAreaFlood    Float       @default(0)
  householdPlan            Float       @default(0)
  householdDone            Float       @default(0)
  householdDoneDrought     Float       @default(0)
  householdDoneFlood       Float       @default(0)
  unsalvageableArea        Float       @default(0)
  unsalvageableAreaDrought Float       @default(0)
  unsalvageableAreaFlood   Float       @default(0)
  overUnderPlan            Float       @default(0)
  waterSource              String      @default("")
  note                     String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  department               Department? @relation(fields: [departmentId], references: [id])
  departmentId             Int?
  userId                   Int?
  provinceId               Int?
  districtId               Int?
  user                     User?       @relation(fields: [userId], references: [id])
  province                 Province?   @relation(fields: [provinceId], references: [id])
  district                 District?   @relation(fields: [districtId], references: [id])
  auditLogs                AuditLog[]
}

model User {
  id                            Int                     @id @default(autoincrement())
  username                      String                  @unique
  passwordHash                  String
  role                          String                  @default("user")
  isActive                      Boolean                 @default(true)
  provinceId                    Int?
  province                      Province?               @relation(fields: [provinceId], references: [id])
  entries                       Entry[]
  waterEntries                  ProvinceWaterEntry[]
  createdDistricts              District[]              @relation("DistrictCreator")
  createdCommunes               Commune[]               @relation("CommuneCreator")
  createdStations               Station[]               @relation("StationCreator")
  createdMeteorologicalStations MeteorologicalStation[] @relation("MeteorologicalStationCreator")
  stationReports                StationReport[]
  auditLogs                     AuditLog[]              @relation("AuditActor")
  temperatures                  DailyTemperature[]
  rainfalls                     DailyRainfall[]
  forecasts                     DailyForecast[]
  fwucs                         Fwuc[]
  floodReports                  ProvincialFloodReport[]
  waterways                     Waterway[]
  reportedTickets               AssetInspectionTicket[] @relation("TicketReporter")

  @@index([isActive])
}

model Province {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique
  khmerName              String                  @default("")
  code                   String?                 @unique
  postalCode             Int?
  sortOrder              Int?
  users                  User[]
  districts              District[]
  entries                Entry[]
  waterEntries           ProvinceWaterEntry[]
  communes               Commune[]
  stations               Station[]
  meteorologicalStations MeteorologicalStation[]
  auditLogs              AuditLog[]
  temperatures           DailyTemperature[]
  rainfalls              DailyRainfall[]
  forecasts              DailyForecast[]
  fwucs                  Fwuc[]
  floodReports           ProvincialFloodReport[]
  waterways              Waterway[]
  basins                 Basin[]

  @@index([sortOrder])
}

model District {
  id                     Int                     @id @default(autoincrement())
  name                   String
  khmerName              String                  @default("")
  geocode                String?
  provinceId             Int
  createdByUserId        Int?
  createdAt              DateTime                @default(now())
  province               Province                @relation(fields: [provinceId], references: [id])
  createdByUser          User?                   @relation("DistrictCreator", fields: [createdByUserId], references: [id])
  entries                Entry[]
  waterEntries           ProvinceWaterEntry[]
  communes               Commune[]
  stations               Station[]
  meteorologicalStations MeteorologicalStation[]
  rainfalls              DailyRainfall[]
  fwucs                  Fwuc[]
  floodReports           ProvincialFloodReport[]
  upstreamWaterways      Waterway[]              @relation("WaterwayUpstreamDistrict")
  downstreamWaterways    Waterway[]              @relation("WaterwayDownstreamDistrict")
  hydraulicStructures    HydraulicStructure[]
  waterUserGroups        WaterUserGroup[]

  @@unique([provinceId, name])
}

model ProvinceWaterEntry {
  id               Int       @id @default(autoincrement())
  basinName        String
  location         String
  districtName     String
  communeName      String?
  totalWater       Float     @default(0)
  waterPercent     Float     @default(0)
  actualWater      Float     @default(0)
  irrigatedDryArea Float     @default(0)
  irrigatedWetArea Float     @default(0)
  otherCrop        Float     @default(0)
  waterSource      String    @default("")
  note             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  provinceId       Int
  districtId       Int?
  communeId        Int?
  userId           Int?
  province         Province  @relation(fields: [provinceId], references: [id])
  district         District? @relation(fields: [districtId], references: [id])
  commune          Commune?  @relation(fields: [communeId], references: [id])
  user             User?     @relation(fields: [userId], references: [id])

  @@index([provinceId, createdAt])
  @@index([districtId])
  @@index([communeId])
}

model Commune {
  id                     Int                     @id @default(autoincrement())
  name                   String
  khmerName              String                  @default("")
  geocode                String?
  numVillages            Int?
  districtId             Int?
  provinceId             Int
  createdByUserId        Int?
  createdAt              DateTime                @default(now())
  province               Province                @relation(fields: [provinceId], references: [id])
  district               District?               @relation(fields: [districtId], references: [id])
  createdByUser          User?                   @relation("CommuneCreator", fields: [createdByUserId], references: [id])
  waterEntries           ProvinceWaterEntry[]
  stations               Station[]
  fwucs                  Fwuc[]
  meteorologicalStations MeteorologicalStation[]
  upstreamWaterways      Waterway[]              @relation("WaterwayUpstreamCommune")
  downstreamWaterways    Waterway[]              @relation("WaterwayDownstreamCommune")
  hydraulicStructures    HydraulicStructure[]
  waterUserGroups        WaterUserGroup[]

  @@unique([provinceId, name])
  @@index([districtId])
}

model Station {
  id                  Int       @id @default(autoincrement())
  name                String
  khmerName           String    @default("")
  river               String?
  category            String?
  monitoringFunctions String?
  warningLevel        Float?
  maxCapacityLevel    Float?
  status              String?
  installationDate    DateTime?
  remark              String?
  latitude            Float?
  longitude           Float?
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provinceId          Int
  districtId          Int?
  communeId           Int?
  createdByUserId     Int?

  province      Province        @relation(fields: [provinceId], references: [id])
  district      District?       @relation(fields: [districtId], references: [id])
  commune       Commune?        @relation(fields: [communeId], references: [id])
  createdByUser User?           @relation("StationCreator", fields: [createdByUserId], references: [id])
  reports       StationReport[]

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model StationReport {
  id                  Int      @id @default(autoincrement())
  stationId           Int
  reportDate          DateTime
  waterLevel          Float
  waterLevelYesterday Float?
  waterLevelLastYear  Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  userId              Int?

  station Station @relation(fields: [stationId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([stationId, reportDate])
}

model AuditLog {
  id            Int       @id @default(autoincrement())
  action        String
  entityType    String
  entityId      Int?
  actorUserId   Int?
  actorUsername String
  provinceId    Int?
  entryId       Int?
  changes       Json
  createdAt     DateTime  @default(now())
  actorUser     User?     @relation("AuditActor", fields: [actorUserId], references: [id])
  province      Province? @relation(fields: [provinceId], references: [id])
  entry         Entry?    @relation(fields: [entryId], references: [id])
}

model DailyTemperature {
  id         Int      @id @default(autoincrement())
  reportDate DateTime
  maxTemp    Float
  minTemp    Float
  provinceId Int
  userId     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province Province @relation(fields: [provinceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([provinceId, reportDate])
  @@index([provinceId, reportDate])
}

model DailyRainfall {
  id          Int      @id @default(autoincrement())
  reportDate  DateTime
  stationName String
  rainfall    Float    @default(0)
  provinceId  Int
  districtId  Int?
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([provinceId, reportDate])
  @@index([districtId])
}

model DailyForecast {
  id           Int      @id @default(autoincrement())
  reportDate   DateTime
  forecastText String
  provinceId   Int
  userId       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  province Province @relation(fields: [provinceId], references: [id])
  user     User?    @relation(fields: [userId], references: [id])

  @@unique([provinceId, reportDate])
  @@index([provinceId, reportDate])
}

model Fwuc {
  id                 Int       @id @default(autoincrement())
  name               String
  provinceId         Int
  districtId         Int?
  communeId          Int?
  longitude          Float?
  latitude           Float?
  registrationPlace  String?
  registrationNumber String?
  registrationDate   DateTime?
  irrigatedDryArea   Float     @default(0)
  irrigatedWetArea   Float     @default(0)
  efficiency         String?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  userId             Int?

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  commune  Commune?  @relation(fields: [communeId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  waterUserGroups WaterUserGroup[]

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model MeteorologicalStation {
  id                  Int       @id @default(autoincrement())
  name                String
  khmerName           String    @default("")
  river               String?
  category            String?
  monitoringFunctions String?
  powerSupply         String?
  communication       String?
  elevation           Float?
  warningLevel        Float?
  maxCapacityLevel    Float?
  status              String?
  installationDate    DateTime?
  remark              String?
  latitude            Float?
  longitude           Float?
  order               Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  provinceId          Int
  districtId          Int?
  communeId           Int?
  createdByUserId     Int?

  province      Province  @relation(fields: [provinceId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])
  commune       Commune?  @relation(fields: [communeId], references: [id])
  createdByUser User?     @relation("MeteorologicalStationCreator", fields: [createdByUserId], references: [id])

  @@index([provinceId])
  @@index([districtId])
  @@index([communeId])
}

model WaterInfrastructure {
  id                      Int                   @id @default(autoincrement())
  provincialFloodReportId Int
  name                    String?               // ឈ្មោះអាងទឹក/ប្រព័ន្ធធារាសាស្ត្រ
  damLength               Float                 @default(0) // ទំនប់ (ម)
  mainCanalLength         Float                 @default(0) // ប្រឡាយមេ (ម)
  subCanalLength          Float                 @default(0) // ប្រឡាយរង (ម)
  tertiaryCanalLength     Float                 @default(0) // ជើងក្អែប (ម)
  spillwayLength          Float                 @default(0) // សំណង់បង្ហៀរ (ម)
  waterGateCount          Int                   @default(0) // ទ្វារទឹក (ចំនួន)
  pipeCulvertCount        Int                   @default(0) // លូ (ចំនួន)
  note                    String?               // សំគាល់
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  provincialFloodReport   ProvincialFloodReport @relation(fields: [provincialFloodReportId], references: [id], onDelete: Cascade)
  
  @@index([provincialFloodReportId])
}

model ProvincialFloodReport {
  id                          Int      @id @default(autoincrement())
  reportDate                  DateTime @default(now())
  provinceId                  Int
  districtId                  Int?
  communesCount               Int      @default(0) 
  affectedFamilies            Int      @default(0) 
  affectedRiceCrops           Float    @default(0) 
  damagedRiceCrops            Float    @default(0) 
  note                        String?              
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  userId                      Int?

  province Province  @relation(fields: [provinceId], references: [id])
  district District? @relation(fields: [districtId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  waterInfrastructures        WaterInfrastructure[]

  @@index([provinceId])
  @@index([districtId])
}

model Waterway {
  id                    Int       @id @default(autoincrement())
  provinceId            Int
  type                  String    // "ទន្លេ", "ស្ទឹង", "ព្រែក", "អូរ"
  name                  String    // ឈ្មោះ
  length                Float     @default(0) // ប្រវែង (គ.ម)
  
  // Upstream (ផ្នែកខាងលើទឹក)
  upstreamDistrictId    Int?
  upstreamCommuneId     Int?
  upstreamLocationX     String?   // ទីតាំង X
  upstreamLocationY     String?   // ទីតាំង Y
  upstreamWidth         Float     @default(0) // មុខកាត់ (ម)
  upstreamElevation     Float     @default(0) // កំពស់ពីនីវ៉ូសមុទ្រ (ម)

  // Downstream (ផ្នែកខាងក្រោមទឹក)
  downstreamDistrictId  Int?
  downstreamCommuneId   Int?
  downstreamLocationX   String?   // ទីតាំង X
  downstreamLocationY   String?   // ទីតាំង Y
  downstreamWidth       Float     @default(0) // មុខកាត់ (ម)
  downstreamElevation   Float     @default(0) // កំពស់ពីនីវ៉ូសមុទ្រ (ម)

  note                  String?
  userId                Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  province              Province  @relation(fields: [provinceId], references: [id])
  upstreamDistrict      District? @relation("WaterwayUpstreamDistrict", fields: [upstreamDistrictId], references: [id])
  downstreamDistrict    District? @relation("WaterwayDownstreamDistrict", fields: [downstreamDistrictId], references: [id])
  upstreamCommune       Commune?  @relation("WaterwayUpstreamCommune", fields: [upstreamCommuneId], references: [id])
  downstreamCommune     Commune?  @relation("WaterwayDownstreamCommune", fields: [downstreamCommuneId], references: [id])
  user                  User?     @relation(fields: [userId], references: [id])

  @@index([provinceId])
  @@index([type])
}

// ==========================================
// STUENG TMAR POUK SUB-BASIN IRRIGATION MODELS
// ==========================================

model Basin {
  id                   Int       @id @default(autoincrement())
  code                 String    @unique
  name                 String
  khmerName            String
  provinceId           Int
  province             Province  @relation(fields: [provinceId], references: [id])
  mainRiverLengthKm    Float     @default(55.0)
  tributaryLengthKm    Float     @default(24.0)
  drySeasonCapacityHa  Float     @default(5000.0)
  wetSeasonCapacityHa  Float     @default(30000.0)
  avgParcelAreaHa      Float     @default(5.0)
  coordinateX          Float?    @default(276528)
  coordinateY          Float?    @default(1549682)
  latitude             Float?    @default(14.015)
  longitude            Float?    @default(102.932)
  description          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  hydraulicStructures  HydraulicStructure[]
  canals               Canal[]
  waterUserGroups      WaterUserGroup[]
  telemetryLogs        InflowTelemetryLog[]
  seasonalAllocations  SeasonalWaterAllocation[]
  floodSurgeAlerts     FloodSurgeAlert[]
  inspectionTickets    AssetInspectionTicket[]
  protectedZones       BasinProtectedZone[]

  @@index([provinceId])
}

model HydraulicStructure {
  id                        Int       @id @default(autoincrement())
  code                      String    @unique
  name                      String
  khmerName                 String
  basinId                   Int
  basin                     Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  structureType             String    // "DIVERSION_WEIR", "DISTRIBUTION_CONTROL", "DRAINAGE_GATE", "PUMPING_LIFT"
  districtId                Int?
  district                  District? @relation(fields: [districtId], references: [id])
  communeId                 Int?
  commune                   Commune?  @relation(fields: [communeId], references: [id])
  locationX                 Float?
  locationY                 Float?
  latitude                  Float?
  longitude                 Float?
  gateCount                 Int       @default(1)
  currentGateOpeningPercent Float     @default(0)
  currentDischargeM3s       Float     @default(0)
  maxDesignCapacityM3s      Float     @default(50.0)
  upstreamWaterLevelM       Float     @default(0)
  downstreamWaterLevelM     Float     @default(0)
  floodMitigationRole       Boolean   @default(true)
  status                    String    @default("OPERATIONAL") // "OPERATIONAL", "ALERT", "MAINTENANCE", "CLOSED"
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  canals                    Canal[]
  telemetryLogs             InflowTelemetryLog[]
  inspectionTickets         AssetInspectionTicket[]

  @@index([basinId])
  @@index([structureType])
}

model Canal {
  id                           Int       @id @default(autoincrement())
  code                         String    @unique
  name                         String
  khmerName                    String
  basinId                      Int
  basin                        Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  parentStructureId            Int?
  parentStructure              HydraulicStructure? @relation(fields: [parentStructureId], references: [id])
  parentCanalId                Int?
  parentCanal                  Canal?    @relation("CanalHierarchy", fields: [parentCanalId], references: [id])
  subCanals                    Canal[]   @relation("CanalHierarchy")
  canalType                    String    // "MAIN", "SECONDARY", "PRESSURIZED_PIPE", "GRAVITY_PIPE"
  lengthKm                     Float
  designDischargeM3s           Float     @default(5.0)
  currentFlowM3s               Float     @default(0)
  conveyanceEfficiencyPercent  Float     @default(85.0)
  linedSectionKm               Float     @default(0)
  unlinedSectionKm             Float     @default(0)
  inspectionRoadCondition      String    @default("GOOD") // "GOOD", "FAIR", "DAMAGED"
  liningIntegrityStatus        String    @default("INTACT") // "INTACT", "CRACKED", "ERODED"
  commandAreaHa                Float     @default(500.0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  inspectionTickets            AssetInspectionTicket[]
  waterUserGroups              WaterUserGroup[]

  @@index([basinId])
  @@index([canalType])
  @@index([parentStructureId])
}

model WaterUserGroup {
  id                 Int       @id @default(autoincrement())
  code               String    @unique
  name               String
  khmerName          String
  basinId            Int
  basin              Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  fwucId             Int?
  fwuc               Fwuc?     @relation(fields: [fwucId], references: [id])
  canalId            Int?
  canal              Canal?    @relation(fields: [canalId], references: [id])
  districtId         Int?
  district           District? @relation(fields: [districtId], references: [id])
  communeId          Int?
  commune            Commune?  @relation(fields: [communeId], references: [id])
  villageName        String?
  leaderName         String?
  leaderContact      String?
  totalFarmersCount  Int       @default(50)
  totalParcelAreaHa  Float     @default(250.0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deliveryRequests   WaterDeliveryRequest[]
  iscBillings        IscBillingRecord[]

  @@index([basinId])
  @@index([fwucId])
  @@index([canalId])
}

model InflowTelemetryLog {
  id                 Int       @id @default(autoincrement())
  basinId            Int
  basin              Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  structureId        Int?
  structure          HydraulicStructure? @relation(fields: [structureId], references: [id])
  sourceOrigin       String    // "CROSS_BORDER_THAILAND", "ODDAR_MEANCHEY_PLATEAU", "STUENG_TMAR_POUK_MAIN", "TRIBUTARY"
  timestamp          DateTime  @default(now())
  dischargeM3s       Float
  gateOpeningPercent Float?
  waterLevelM        Float
  turbidityNtu       Float?
  anomalyDetected    Boolean   @default(false)
  anomalyReason      String?
  notes              String?
  createdAt          DateTime  @default(now())

  @@index([basinId, timestamp])
  @@index([sourceOrigin])
}

model SeasonalWaterAllocation {
  id                           Int       @id @default(autoincrement())
  basinId                      Int
  basin                        Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  seasonName                   String    // "DRY_SEASON", "WET_SEASON"
  year                         Int
  cropSeasonCode               String    // "S1_APR_JUL", "S2_OCT_DEC", "CASH_CROP_ROTATION"
  plannedAreaHa                Float
  allocatedWaterM3             Float
  dispatchedWaterM3            Float     @default(0)
  openCanalSharePercent        Float     @default(75.0)
  pipeDistributionSharePercent Float     @default(25.0)
  startDate                    DateTime
  endDate                      DateTime
  status                       String    @default("ACTIVE") // "ACTIVE", "PLANNED", "COMPLETED"
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@index([basinId, year])
  @@index([cropSeasonCode])
}

model FloodSurgeAlert {
  id                   Int       @id @default(autoincrement())
  basinId              Int
  basin                Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  alertLevel           String    // "NORMAL", "WATCH", "WARNING", "EMERGENCY_CRITICAL"
  sourceLocation       String
  peakInflowM3s        Float
  diversionPlanKh      String
  riskReductionPercent Float     @default(80.0)
  gatesCoordinated     Json?
  activeAlert          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  resolvedAt           DateTime?

  @@index([basinId, activeAlert])
}

model AssetInspectionTicket {
  id                         Int       @id @default(autoincrement())
  ticketNumber               String    @unique
  basinId                    Int
  basin                      Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  canalId                    Int?
  canal                      Canal?    @relation(fields: [canalId], references: [id])
  structureId                Int?
  structure                  HydraulicStructure? @relation(fields: [structureId], references: [id])
  assetType                  String    // "CANAL", "WEIR", "CONTROL_STRUCTURE", "PIPE_NETWORK", "INSPECTION_ROAD"
  defectCategory             String    // "LINING_INTEGRITY", "BANK_EROSION", "ROAD_DAMAGE", "GATE_LEAKAGE", "SEDIMENTATION"
  severity                   String    // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status                     String    // "REPORTED", "INVESTIGATING", "WORK_ORDER_APPROVED", "REPAIRED", "REJECTED_PROTECTED_ZONE"
  locationX                  Float?
  locationY                  Float?
  latitude                   Float?
  longitude                  Float?
  insideProtectedZone        Boolean   @default(false)
  protectedZoneName          String?
  safeguardValidationPassed Boolean   @default(true)
  description                String
  actionTaken                String?
  reportedByUserId           Int?
  reportedByUser             User?     @relation("TicketReporter", fields: [reportedByUserId], references: [id])
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([basinId, status])
  @@index([defectCategory])
}

model WaterDeliveryRequest {
  id                    Int            @id @default(autoincrement())
  requestNumber         String         @unique
  waterUserGroupId      Int
  waterUserGroup        WaterUserGroup @relation(fields: [waterUserGroupId], references: [id], onDelete: Cascade)
  requestType           String         // "WATER_DELIVERY", "SERVICE_DISRUPTION", "CANAL_MAINTENANCE"
  requestedVolumeM3     Float?
  requestedDischargeM3s Float?
  requestedDate         DateTime
  durationDays          Int            @default(3)
  cropType              String
  parcelsCount          Int            @default(10)
  targetAreaHa          Float          @default(50.0)
  status                String         @default("PENDING") // "PENDING", "APPROVED", "DELIVERING", "FULFILLED", "REJECTED"
  pdwramReviewNotes     String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([waterUserGroupId, status])
}

model IscBillingRecord {
  id                  Int            @id @default(autoincrement())
  invoiceNumber       String         @unique
  waterUserGroupId    Int
  waterUserGroup      WaterUserGroup @relation(fields: [waterUserGroupId], references: [id], onDelete: Cascade)
  seasonName          String
  year                Int
  billingType         String         // "PER_HECTARE", "CONSUMPTION_M3"
  ratePerUnit         Float
  totalAreaHa         Float
  totalConsumptionM3  Float?
  totalAmountKhr      Float
  paymentStatus       String         // "UNPAID", "PARTIALLY_PAID", "PAID"
  collectedAmountKhr  Float          @default(0)
  dueDate             DateTime
  paidAt              DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([waterUserGroupId, paymentStatus])
  @@index([year, seasonName])
}

model BasinProtectedZone {
  id               Int       @id @default(autoincrement())
  basinId          Int
  basin            Basin     @relation(fields: [basinId], references: [id], onDelete: Cascade)
  zoneName         String
  zoneType         String    // "PROTECTED_LANDSCAPE", "WILDLIFE_SANCTUARY", "WATERSHED_RESERVE"
  minX             Float
  maxX             Float
  minY             Float
  maxY             Float
  minLat           Float
  maxLat           Float
  minLng           Float
  maxLng           Float
  restrictionLevel String    // "STRICT_NO_CONSTRUCTION", "BUFFER_ZONE_PERMIT_REQUIRED"
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([basinId])
}
